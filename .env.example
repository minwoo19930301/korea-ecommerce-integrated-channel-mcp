KEIC_ALLOW_MUTATIONS=false
KEIC_DATABASE_PATH=./korea_ecommerce_integrated_channel.sqlite3
KEIC_PROFILE_DIRECTORY=./profiles
KEIC_TRANSPORT=stdio
KEIC_APPROVAL_TTL_SECONDS=900

# SmartStore Commerce API
KEIC_NAVER_CLIENT_ID=
KEIC_NAVER_CLIENT_SECRET=
KEIC_NAVER_ACCOUNT_ID=

# Coupang seller API
KEIC_COUPANG_VENDOR_ID=
KEIC_COUPANG_ACCESS_KEY=
KEIC_COUPANG_SECRET_KEY=

# 11st seller API
KEIC_ELEVENST_API_KEY=
KEIC_ELEVENST_BASE_URL=https://api.11st.co.kr/rest
# Override these only when the seller account contract uses different routes.
KEIC_ELEVENST_CREATE_PATH=/prodservices/product
KEIC_ELEVENST_UPDATE_PATH=/prodservices/product/{external_id}
KEIC_ELEVENST_DELETE_PATH=/prodservices/product/{external_id}
KEIC_ELEVENST_STOP_PATH=/prodstatservice/stat/stopdisplay/{external_id}
KEIC_ELEVENST_RESUME_PATH=/prodstatservice/stat/restartdisplay/{external_id}

# ESM seller API
KEIC_ESM_MASTER_ID=
KEIC_ESM_SECRET_KEY=
KEIC_ESM_GMARKET_SELLER_ID=
KEIC_ESM_AUCTION_SELLER_ID=
KEIC_ESM_ISSUER=
